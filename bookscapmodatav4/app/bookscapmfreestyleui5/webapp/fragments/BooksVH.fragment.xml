<core:FragmentDefinition xmlns:basket="sap.esh.search.ui.controls.basket"
   xmlns="sap.m"
   xmlns:core="sap.ui.core" >
   <Dialog
     
      title="Books Library"
      class="sapuiContentPadding">

 <Table items = "{bk>/BooksSet}" >
    <columns>
    <Column>
    <Text text ="Title"></Text>
  </Column>
  <Column>
    <Text text ="Author"></Text>
  </Column>
    </columns>   
    <items>
    <ColumnListItem type ="Active" press="onBookRowPress">
     <cells>
     <Text text = "{bk>title}"></Text>
        <Text text = "{bk>author}"></Text>
          
     </cells>
    </ColumnListItem>

    </items>
     </Table>

      <endButton>
      <Button text = "Cancel" press = "_onCancelBookVh"/>
      </endButton>

      </Dialog>
</core:FragmentDefinition>